AXIOM_DATABASE_URL=postgresql+psycopg://axiom:axiom@localhost:5432/axiom
AXIOM_REDIS_URL=redis://localhost:6379/0
AXIOM_CELERY_BROKER_URL=redis://localhost:6379/0
AXIOM_CELERY_RESULT_BACKEND=redis://localhost:6379/1
AXIOM_DATA_ROOT=data
AXIOM_JOBS_ROOT=jobs
AXIOM_LEAN_IMAGE=quantconnect/lean:16355
AXIOM_CORS_ORIGINS=http://localhost:3000
AXIOM_RISK_FREE_RATE=0
AXIOM_LEAN_TIMEOUT_SECONDS=1800
AXIOM_DATA_PROVIDER=auto
NEXT_PUBLIC_API_URL=http://localhost:8000

# Colima Docker runtime (installed via Homebrew; preferred over Docker Desktop here)
DOCKER_HOST=unix://${HOME}/.colima/default/docker.sock


