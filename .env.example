# Configuration guide and phase-specific keys: docs/PLAN.md section 8.
# Database credentials are NOT defaulted. Generate a password and fill it
# in everywhere below:
#   openssl rand -hex 16
STREET_DATABASE_URL=postgresql+psycopg://street:CHANGE_ME@localhost:5432/street
STREET_REDIS_URL=redis://localhost:6379/0
STREET_CELERY_BROKER_URL=redis://localhost:6379/0
STREET_CELERY_RESULT_BACKEND=redis://localhost:6379/1
STREET_DATA_ROOT=data
STREET_JOBS_ROOT=jobs
STREET_LEAN_IMAGE=quantconnect/lean:16355
STREET_CORS_ORIGINS=http://localhost:3000
STREET_RISK_FREE_RATE=0
STREET_SYNC_BACKTESTS=false
STREET_SYNC_INGESTS=false
STREET_MAX_INFLIGHT_BACKTESTS=2
STREET_WORKER_CONCURRENCY=2
STREET_LEAN_POOL_SIZE=2
STREET_LEAN_POOL_WARM=false
STREET_SCAN_PARALLELISM=2
STREET_LEAN_TIMEOUT_SECONDS=1800
STREET_MARKET_RECONCILE_ENABLED=true
STREET_MARKET_RECONCILE_INTERVAL_SECONDS=86400
STREET_MARKET_RECONCILE_PROVIDER=auto
STREET_MARKET_RECONCILE_WITH=
STREET_INGEST_MAX_SYMBOLS=500
STREET_INGEST_RPS=2
STREET_INGEST_CONCURRENCY=4
STREET_INGEST_BURST=2
POSTGRES_USER=street
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=street
STREET_DATA_PROVIDER=auto
STREET_RECONCILE_WITH=
# Frontend: copy this variable into apps/web/.env.local (runtime server only).
API_BASE_URL=http://127.0.0.1:8000

# Colima Docker runtime (installed via Homebrew; preferred over Docker Desktop here)
DOCKER_HOST=unix://${HOME}/.colima/default/docker.sock

# --- Optional observability ---
# Native runs default OTel off; the docker compose stack sets these on and points
# OTel at the bundled Jaeger. Prometheus /metrics is on by default.
STREET_OTEL_ENABLED=false
# STREET_OTEL_ENDPOINT=http://localhost:4317   # OTLP/gRPC -> local Jaeger
# STREET_PROMETHEUS_ENABLED=true
# Sentry errors-only: native runs read STREET_SENTRY_DSN; docker compose maps the
# host SENTRY_DSN -> container STREET_SENTRY_DSN. Empty = fully disabled.
# STREET_SENTRY_DSN=
# SENTRY_DSN=


# Optional market provider, implemented in quant/data/providers.py.
# Present = default primary (dual-source reconcile yfinance).
# Native runs must inject POLYGON_API_KEY into the process environment;
# Settings dotenv loading alone does not populate os.environ for this provider.
# POLYGON_API_KEY=
# STREET_RECONCILE_WITH=          # empty = unset; Polygon still reconciles with yfinance
# Future providers: NOT IMPLEMENTED. Setting these does not enable a connection.
# Internal paper simulation needs no broker credentials. See plan P5/P6.
# ALPACA_API_KEY=
# ALPACA_API_SECRET=
# ALPACA_PAPER=true
# ALPHA_VANTAGE_API_KEY=
# TIINGO_API_KEY=

# --- Optional research assistant (current aggregate-only provider) ---
# DeepSeek API key for the Copilot 劝停 synthesize task. Empty (or unset) =
# provider disabled: the platform never dials out, the panel shows the honest
# disabled state, and POST /copilot/synthesize answers 503.
# STREET_DEEPSEEK_API_KEY=
# STREET_COPILOT_MODEL=deepseek-v4-flash   # current code default; verify model availability/alias before use
