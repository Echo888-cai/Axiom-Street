STREET_DATABASE_URL=postgresql+psycopg://street:street@localhost:5432/street
STREET_REDIS_URL=redis://localhost:6379/0
STREET_CELERY_BROKER_URL=redis://localhost:6379/0
STREET_CELERY_RESULT_BACKEND=redis://localhost:6379/1
STREET_DATA_ROOT=data
STREET_JOBS_ROOT=jobs
STREET_LEAN_IMAGE=quantconnect/lean:16355
STREET_CORS_ORIGINS=http://localhost:3000
STREET_RISK_FREE_RATE=0
STREET_SYNC_BACKTESTS=false
STREET_SYNC_INGESTS=false
STREET_MAX_INFLIGHT_BACKTESTS=2
STREET_WORKER_CONCURRENCY=2
STREET_LEAN_TIMEOUT_SECONDS=1800
STREET_MARKET_RECONCILE_ENABLED=true
STREET_MARKET_RECONCILE_INTERVAL_SECONDS=86400
STREET_MARKET_RECONCILE_PROVIDER=auto
STREET_MARKET_RECONCILE_WITH=
STREET_INGEST_MAX_SYMBOLS=500
STREET_INGEST_RPS=2
STREET_INGEST_CONCURRENCY=4
STREET_INGEST_BURST=2
POSTGRES_USER=street
POSTGRES_PASSWORD=street
POSTGRES_DB=street
STREET_DATA_PROVIDER=auto
STREET_RECONCILE_WITH=
NEXT_PUBLIC_API_URL=http://localhost:8000

# Colima Docker runtime (installed via Homebrew; preferred over Docker Desktop here)
DOCKER_HOST=unix://${HOME}/.colima/default/docker.sock


